# BeneFi — Environment Variables
# Copy this file to .env.local and fill in your values

# ── SMTP (Google Workspace) ─────────────────────────────────────────────────
# SMTP_USER  : The Google Workspace account that sends the email (e.g. sales@benefi.ph)
# SMTP_PASS  : A Google Workspace App Password (16 chars, no spaces)
#
# How to generate an App Password for Google Workspace:
#   1. Sign in to admin.google.com
#   2. Go to Security → 2-Step Verification → App passwords
#   OR (for personal account): myaccount.google.com → Security → App passwords
#   3. Select "Mail" + device "Other (custom)" → enter "BeneFi Server"
#   4. Copy the 16-character password shown

SMTP_USER=sales@benefi.ph
SMTP_PASS=your_16_char_app_password

# ── Server ──────────────────────────────────────────────────────────────────
SERVER_PORT=3001
CORS_ORIGIN=http://localhost:3000
