# BeneFi — Environment Variables
# Copy this file to .env.local and fill in your values

# ── MySQL Database ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=benefi

# ── SMTP / Google Workspace (parked — leave blank until ready) ───────────────
# SMTP_USER=sales@benefi.ph
# SMTP_PASS=your_16_char_app_password

# ── Admin token (keep secret — used to access /api/submissions) ───────────────
ADMIN_TOKEN=your_secret_admin_token_here

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=3001
CORS_ORIGIN=http://localhost:3000
